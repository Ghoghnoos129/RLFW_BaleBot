# توکن ربات که از BLB (پنل ساخت ربات بله) دریافت می‌کنید
BALE_TOKEN=PUT_YOUR_TOKEN_HERE

# --- روش ساده و پیشنهادی برای تعیین ادمین: کد مخفی ---
# یک رشته دلخواه بگذارید (مثلاً یک عدد یا کلمه تصادفی). هر کس همین رشته را عیناً به
# ربات پیام بدهد، ادمین می‌شود. اولین نفر «مدیر اصلی» می‌شود و تنها او می‌تواند بعدا
# مدیرهای دیگر را با دستور /حذف_مدیر حذف کند.
# بعد از اینکه مدیرهای لازم را اضافه کردید، برای امنیت بیشتر این مقدار را عوض یا خالی کنید.
ADMIN_SETUP_CODE=یک-رمز-دلخواه-بگذارید

# --- روش جایگزین/پیشرفته (اختیاری) ---
# اگر از قبل آیدی عددی ادمین را می‌دانید، می‌توانید مستقیم اینجا بگذارید (با کاما جدا کنید).
# این روش نیازی ندارد و معمولا لازم نیست پر شود؛ ADMIN_SETUP_CODE بالا کافی است.
ADMIN_IDS=

# مسیرهای داده/لاگ/heartbeat — داخل کانتینر روی volume قرار می‌گیرند، نیازی به تغییر نیست
DB_PATH=./data/league.db
LOG_PATH=./data/bot.log
HEARTBEAT_PATH=./data/heartbeat

# نام فصل فعلی که در پیام‌ها نمایش داده می‌شود (می‌توانید با دستور ادمین هم تغییرش دهید)
DEFAULT_SEASON_PREFIX=فصل
